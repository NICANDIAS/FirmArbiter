{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://firmarbiter.example/schemas/adapter-manifest-v1.schema.json",
  "title": "FIRMARBITER Adapter Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "adapter",
    "candidate",
    "build",
    "runtime",
    "capabilities"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "display_name",
        "version",
        "contract_version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "minLength": 2,
          "maxLength": 64
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "description": {
          "type": "string",
          "maxLength": 1000
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$"
        },
        "contract_version": {
          "const": "1.0"
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "source"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "license": {
          "type": "string",
          "maxLength": 128
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "repository",
            "commit"
          ],
          "properties": {
            "type": {
              "const": "git"
            },
            "repository": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "commit": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{40}$"
            },
            "requested_ref": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            }
          }
        },
        "patches": {
          "type": "array",
          "default": [],
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256",
              "description"
            ],
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^patches/[A-Za-z0-9._/-]+$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              }
            }
          }
        }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "context",
        "dockerfile",
        "platform",
        "base_images"
      ],
      "properties": {
        "context": {
          "type": "string",
          "pattern": "^(\\.|[A-Za-z0-9._/-]+)$"
        },
        "dockerfile": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._/-]+$"
        },
        "platform": {
          "type": "string",
          "enum": [
            "linux/amd64",
            "linux/arm64",
            "linux/386",
            "linux/arm/v7"
          ]
        },
        "base_images": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[^\\s@]+@sha256:[0-9a-f]{64}$"
          }
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_as_root",
        "network",
        "requirements"
      ],
      "properties": {
        "run_as_root": {
          "type": "boolean"
        },
        "network": {
          "type": "string",
          "enum": [
            "none",
            "isolated",
            "host"
          ]
        },
        "requirements": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "kvm",
              "loop-devices",
              "device-mapper",
              "tun-tap",
              "net-admin",
              "ptrace",
              "nested-containers",
              "full-privileged"
            ]
          }
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stages",
        "firmware_architectures",
        "endpoint_protocols",
        "hints"
      ],
      "properties": {
        "stages": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "unpack",
              "emulate",
              "static-analysis",
              "dynamic-analysis",
              "endpoint-discovery"
            ]
          }
        },
        "firmware_architectures": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "arm",
              "arm64",
              "mips",
              "mipsel",
              "x86",
              "x86_64",
              "powerpc",
              "unknown"
            ]
          }
        },
        "endpoint_protocols": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "tcp",
              "udp",
              "http",
              "https",
              "ssh",
              "telnet",
              "other"
            ]
          }
        },
        "hints": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "architecture",
            "vendor"
          ],
          "properties": {
            "architecture": {
              "type": "string",
              "enum": [
                "unsupported",
                "optional",
                "required"
              ]
            },
            "vendor": {
              "type": "string",
              "enum": [
                "unsupported",
                "optional",
                "required"
              ]
            }
          }
        }
      }
    }
  }
}
